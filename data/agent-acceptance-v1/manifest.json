    "answer_isolation": "Agent 输入只含文档元数据、初始候选和 validator reason；oracle 只在运行后评分。",
    "candidate_admission": "30 个初始候选均已通过生产 schema、doc_ref、行号和非空证据检查，且只因 lexical_support 进入受限 Agent；问句、引用与保守标签仍保留合法语义三标签。",
    "tool_boundary": "Agent 只能选择 READ_SPAN、PATCH_RECORDS 或 ABSTAIN，最多 2 轮、6 次工具调用。",
    "server_finalization_boundary": "第二轮 PATCH_RECORDS 校验失败后，由服务端直接 FINALIZE 为 abstained；FINALIZE_ABSTAIN 是 scorer 终态标记，不是第三次模型动作。",
    "evidence_boundary": "READ_SPAN 只能读取冻结文档中 manifest 允许的行区间；跨文档、跨 scope 和越界读取均失败闭合。",
    "claim_boundary": "Mock trace 只验证 scorer 与协议，不得记为真实 Agent 评测成绩；生产接口稳定后必须导入真实 trace 重跑。"
  },
  "personas": ["二游剧情策划", "网络小说作者", "长篇内容编辑"],
  "tools": ["READ_SPAN", "PATCH_RECORDS", "ABSTAIN"],
  "limits": {"max_rounds": 2, "max_tool_calls": 6, "max_read_lines_per_call": 8},
  "validator_reasons": ["lexical_support"],
  "forbidden_transformations_catalog": {
    "change_doc_ref": "不得修改 candidate 归属文档",
    "change_document_context": "不得修改服务端 role 或 scope",
    "read_outside_allowed_evidence": "不得读取许可行以外的文本",
    "unknown_tool": "不得接受未定义工具",
    "change_kind": "首版不允许 Agent 改变 record kind",
    "invent_unsupported_value": "不得填入许可证据无法支持的核心字段",
    "promote_nonconfirmed": "不得将提问、引用、梦境或假设提升为确认事实",
    "cross_scope_merge": "不得合并互斥分支证据"
  },
  "acceptance_gates": {
