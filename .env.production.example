# Copy to a server-only env file outside version control and replace every
# placeholder. Never use these example values in a real deployment.
PUBLIC_ORIGIN=https://loreguard.example.com
WEB_BIND_PORT=8080

AUTH_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters

POSTGRES_DB=loreguard
POSTGRES_USER=loreguard_app
POSTGRES_PASSWORD=replace-with-a-strong-random-database-password
# URL-encode reserved characters in the username/password component.
DATABASE_URL=postgresql+psycopg://loreguard_app:replace-with-url-encoded-password@postgres:5432/loreguard

# Provider configuration remains optional until the corresponding feature is
# enabled. Keep real provider keys only in the server-side env file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Required by the production Compose boundary. Create this JSON file outside
# Git with restrictive host permissions. Each value is a base64-encoded random
# 32-byte key; the file must be unrelated to AUTH_SECRET_KEY. Compose mounts
# the same read-only secret into API and worker without exposing it in their
# environment or `docker inspect` output.
ACCOUNT_MODEL_ACTIVE_KEY_ID=prod-v1
ACCOUNT_MODEL_KEYRING_FILE=C:/secure/loreguard-account-model-keyring.json
# Exact HTTPS origins only; no paths, wildcards, IP literals, localhost or .local.
ACCOUNT_MODEL_ALLOWED_ORIGINS=https://api.openai.com
ENABLE_MODEL_EXTRACTION=false
