# Checked-in non-secret interpolation input for the isolated E2E Compose stack.
# Passing this file explicitly prevents Docker Compose from loading the local
# project .env, while the E2E override also disables every external AI path.
OPENAI_API_KEY=
OPENAI_BASE_URL=http://127.0.0.1:9/v1
OPENAI_MODEL=e2e-disabled
ENABLE_MODEL_EXTRACTION=false
ENABLE_EMBEDDINGS=false
EMBEDDING_API_KEY=
ENABLE_ISSUE_EVIDENCE_REVIEW=false
ENABLE_REVIEW_AGENT=false
