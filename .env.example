DATABASE_URL=sqlite:///./loreguard.db
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false
# Local demos deliberately use the durable local identity. Public deployments
# must switch to required and provide an independent server-only secret.
DEPLOYMENT_ENVIRONMENT=local
AUTH_MODE=anonymous
AUTH_SECRET_KEY=
AUTH_SESSION_TTL_SECONDS=1209600
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Comma-separated exact origins. Wildcards are rejected because browser
# credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
# Full evaluated commit SHA. Leave empty for ordinary development; frozen live
# evaluation provenance fails closed until API and worker both receive it.
LOREGUARD_BUILD_REVISION=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Per-account chat keys are encrypted with a separate AES-256-GCM keyring.
# Local non-Docker runs may leave KEYRING_JSON/FILE empty; LoreGuard then
# creates the ignored local key file below. API and worker processes must share
# the same keyring. ALLOWED_ORIGINS is an exact HTTPS-origin allowlist.
ACCOUNT_MODEL_ACTIVE_KEY_ID=local-v1
ACCOUNT_MODEL_KEYRING_JSON=
ACCOUNT_MODEL_KEYRING_FILE=
ACCOUNT_MODEL_LOCAL_KEY_PATH=data/account-model-master.key
ACCOUNT_MODEL_ALLOWED_ORIGINS=https://api.openai.com
ENABLE_MODEL_EXTRACTION=false
# Optional character-profile extraction and drift review.  This capability
# uses the chat Provider but remains independently opt-in.  A partial or
# degraded pass is surfaced as incomplete coverage, never as "no problems".
ENABLE_CHARACTER_CONSISTENCY=false
CHARACTER_CONSISTENCY_SENSITIVITY=balanced
CHARACTER_CONSISTENCY_STAGE_TOKEN_BUDGET=60000
CHARACTER_CONSISTENCY_MAX_CHUNKS_PER_RUN=24
CHARACTER_CONSISTENCY_MAX_CANDIDATES_PER_RUN=64
CHARACTER_SIGNAL_MAX_CHUNK_CHARS=8000
CHARACTER_SIGNAL_MAX_RECORDS=48
CHARACTER_SIGNAL_TARGETED_MAX_TARGETS_PER_CHUNK=12
# Slow compatible gateways may legitimately need more than 20 seconds for a
# structured package. Two transport attempts still share this hard 60s wall.
CHARACTER_SIGNAL_TIMEOUT_SECONDS=30
CHARACTER_SIGNAL_MAX_ATTEMPTS=2
CHARACTER_SIGNAL_PACKAGE_MAX_ATTEMPTS=2
CHARACTER_SIGNAL_TOTAL_DEADLINE_SECONDS=60
# Shared by the initial full package and at most one validation-driven full
# regeneration; each response still uses CHARACTER_SIGNAL_MAX_COMPLETION_TOKENS.
CHARACTER_SIGNAL_TOKEN_BUDGET=22000
CHARACTER_SIGNAL_MAX_COMPLETION_TOKENS=4096
CHARACTER_SIGNAL_MAX_RESPONSE_BYTES=64000
CHARACTER_DRIFT_MAX_OBSERVATIONS=12
CHARACTER_DRIFT_MAX_SUPPORT_EVIDENCE=8
CHARACTER_DRIFT_MAX_EVIDENCE_CHARS=8000
CHARACTER_DRIFT_TOKEN_BUDGET=4000
CHARACTER_DRIFT_TIMEOUT_SECONDS=30
CHARACTER_DRIFT_MAX_ATTEMPTS=2
CHARACTER_DRIFT_TOTAL_DEADLINE_SECONDS=60
CHARACTER_DRIFT_MAX_COMPLETION_TOKENS=1000
CHARACTER_DRIFT_MAX_RESPONSE_BYTES=32000
# Independent opt-in Evidence RAG embedding capability. These settings never
# inherit OPENAI_* chat/extraction values.
ENABLE_EMBEDDINGS=false
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_MODEL_REVISION=unspecified
EMBEDDING_DEPLOYMENT_FINGERPRINT=unspecified
EMBEDDING_PROFILE_NAMESPACE=default
EMBEDDING_DIMENSIONS=
EMBEDDING_ALLOW_INSECURE_HTTP=false
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_MAX_ATTEMPTS=2
EMBEDDING_TOTAL_DEADLINE_SECONDS=20
EMBEDDING_MAX_RESPONSE_BYTES=4194304
EMBEDDING_BATCH_MAX_ITEMS=64
EMBEDDING_BATCH_MAX_CHARS=120000
# Optional post-rule AI evidence review. The RAG Compose overlay enables it
# automatically; the default stack keeps it off.
ENABLE_ISSUE_EVIDENCE_REVIEW=false
ISSUE_EVIDENCE_REVIEW_MAX_ISSUES=8
ISSUE_EVIDENCE_REVIEW_TOP_K=6
ISSUE_EVIDENCE_REVIEW_BATCH_SIZE=4
ISSUE_EVIDENCE_REVIEW_MAX_EVIDENCE_CHARS=6000
ISSUE_EVIDENCE_REVIEW_TOKEN_BUDGET=6000
ISSUE_EVIDENCE_REVIEW_TIMEOUT_SECONDS=20
ISSUE_EVIDENCE_REVIEW_TOTAL_DEADLINE_SECONDS=45
ISSUE_EVIDENCE_REVIEW_MAX_COMPLETION_TOKENS=1400
ISSUE_EVIDENCE_REVIEW_MAX_RESPONSE_BYTES=64000
ISSUE_EVIDENCE_REVIEW_REQUIRE_HYBRID=true
# Optional evidence-seeking native-tool loop. It remains off even when the RAG
# Docker overlay is active and requires ENABLE_EMBEDDINGS=true. Setting
# EVIDENCE_INVESTIGATOR_REQUIRE_HYBRID=false permits a diagnosed lexical
# fallback after a transient index/query-vector failure; it never enables a
# no-embedding operating mode. Token values are internal admission
# reservations, not a guaranteed upper bound on provider billing.
ENABLE_EVIDENCE_INVESTIGATOR=false
EVIDENCE_INVESTIGATOR_MAX_SEEDS=1
EVIDENCE_INVESTIGATOR_MAX_DECISION_ROUNDS=6
EVIDENCE_INVESTIGATOR_MAX_TOOL_CALLS=6
EVIDENCE_INVESTIGATOR_MAX_SEARCHES=2
EVIDENCE_INVESTIGATOR_MAX_READS=2
EVIDENCE_INVESTIGATOR_MAX_RESULTS=12
EVIDENCE_INVESTIGATOR_MAX_READ_LINES=12
EVIDENCE_INVESTIGATOR_MAX_SPAN_CHARS=12000
EVIDENCE_INVESTIGATOR_TOKEN_BUDGET=16000
EVIDENCE_INVESTIGATOR_MAX_PROMPT_BYTES=131072
# Defaults are the normal operating limits. Higher values (up to 120s per
# call and 600s total) are only for diagnosing a slow Provider and do not
# demonstrate that latency or production performance targets have been met.
EVIDENCE_INVESTIGATOR_TIMEOUT_SECONDS=30
EVIDENCE_INVESTIGATOR_TOTAL_DEADLINE_SECONDS=60
EVIDENCE_INVESTIGATOR_MAX_COMPLETION_TOKENS=768
EVIDENCE_INVESTIGATOR_MAX_RESPONSE_BYTES=64000
EVIDENCE_INVESTIGATOR_TOP_K=6
EVIDENCE_INVESTIGATOR_BRANCH_LIMIT=30
# Per-run local embedding resource quota; characters, not chat tokens/API cost.
EVIDENCE_INVESTIGATOR_EMBEDDING_MAX_INPUT_CHARS=250000
EVIDENCE_INVESTIGATOR_REQUIRE_HYBRID=true
# Experimental: requires frozen-model evaluation before production/default use.
ENABLE_REVIEW_AGENT=false
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_ATTEMPTS=2
# Optional whole-call ceilings shared by chat capabilities. Blank means the
# capability-specific limit remains authoritative.
PROVIDER_TOTAL_DEADLINE_SECONDS=
PROVIDER_MAX_COMPLETION_TOKENS=
PROVIDER_MAX_RESPONSE_BYTES=2097152
# Optional relay extension: omit for generic OpenAI-compatible behavior.
# PROVIDER_THINKING_MODE=disabled
MODEL_CIRCUIT_BREAKER_FAILED_DOCUMENTS=1
MODEL_CHUNK_MAX_CHARS=6000
MODEL_CHUNK_OVERLAP_LINES=1
MODEL_MAX_CHUNKS_PER_DOCUMENT=24
PER_RUN_TOKEN_BUDGET=100000
# Local daily safety cap shared by API admission and workers; raise explicitly for
# authorized high-volume evaluations instead of changing the checked-in default.
DAILY_TOKEN_BUDGET=100000
MODEL_INPUT_PRICE_PER_MILLION=
MODEL_OUTPUT_PRICE_PER_MILLION=
MAX_UPLOAD_BYTES=10485760
DIFF_MAX_LINES_PER_VERSION=20000
DIFF_MAX_CHARS_PER_VERSION=2000000
DIFF_MAX_OUTPUT_LINES=4000
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60
